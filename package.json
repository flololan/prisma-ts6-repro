{
  "name": "prisma-ts6-nested-typesafety-repro",
  "version": "1.0.0",
  "private": true,
  "description": "Reproduction for prisma/orm#30190 / #29519: nested query type safety silently lost on TypeScript >= 6.0",
  "scripts": {
    "generate": "prisma generate",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:ts5": "npx -y -p typescript@5.9.2 tsc --noEmit -p tsconfig.json",
    "check:ts7": "npx -y -p typescript@7 tsc --noEmit -p tsconfig.json",
    "repro": "bash verify.sh"
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "typescript": "6.0.3"
  }
}
